# =============================================================
# .env.example — autotunnel 配置模板(复制为 .env 后修改)
# 本文件是项目配置的唯一数据源(.env-wins): 其中定义的键优先于
# 沙盒/系统 shell 注入的同名变量(加载器: src/lib/adapter/project-env.ts)
# =============================================================

PORT=3000
# 在 github settings secret 只能配置名称: ADMIN_SECRET, JWT_SECRET
# ===== Admin =====
ADMIN_SECRET=admin123
JWT_SECRET=a91213aea3a8b6c3743b3fff5bcbbc5b
BASE_URL=/
ADMIN_URL=/admin

# ===== Database =====
# Node.js: SQLite file | Cloudflare: D1 binding (auto-detected)
# 数据库文件路径/名称唯一真源; 相对路径按 Prisma 约定相对 prisma/ 目录解析:
#   file:./autotunnel.db → prisma/autotunnel.db
DATABASE_URL="file:./autotunnel.db"

# =============================================================
# ===== worker 核心可选变量(原版语义, 全部可留空; 部署时自动注入) =====
# 说明: Cloudflare 线上由工作流注入 ADMIN_SECRET/JWT_SECRET; 其余变量
#   如需覆盖, 在 Pages 项目 Settings → Environment variables 添加同名键。

# KEY: 快速订阅路径 + 加密秘钥(留空使用内置默认)
#KEY=
# UUID: 固定节点 UUID(合法 v4 格式; 留空由密码派生)
#UUID=
# HOST: 额外域名(逗号分隔)
#HOST=
# PROXYIP: 反代 IP(支持 https://unixsocket 等前缀)
#PROXYIP=
# BEST_SUB: '1' 开启优选订阅生成器模式
#BEST_SUB=
# URL: 伪装页地址('nginx' 内置 / '1101' 特殊页 / 自定义 https://)
#URL=
# GO: '2' 走全局(反向)代理模式
#GO=
# DEBUG: 调试日志
#DEBUG=
# OFF_LOG: '1' 关闭日志记录
#OFF_LOG=
# TCP_CONCURRENT_DIAL / PROXY_CONCURRENT_DIAL / PRELOAD_RACE_DIAL: 连接策略
#TCP_CONCURRENT_DIAL=
#PROXY_CONCURRENT_DIAL=
#PRELOAD_RACE_DIAL=
# ---- 传输路径 ----
# 原核心读取 PATH 变量(与系统 PATH 冲突), 本项目约定 WS_PATH 自动映射
#WS_PATH=

# =============================================================
# ===== Cloudflare 用量统计默认凭据(管理后台"部署默认凭据"方案) =====
# Cloudflare 部署: workflow 自动把 CLOUDFLARE_API_TOKEN/CLOUDFLARE_ACCOUNT_ID
#   注入 Pages env_vars, 无需在此配置; Node.js 部署在下方填入即可:
# CLOUDFLARE_API_TOKEN=   统计凭据(需含 Account Analytics: Read 权限)
# CLOUDFLARE_ACCOUNT_ID=  可留空(自动用 Token 探测第一个账户)

# =============================================================
# ===== v1.0.2 自动同步更新 + 面板作者链接 =====

# ---- 管理面板社交入口(左下角 GitHub/Telegram 图标指向) ----
# 留空 = 保持原项目作者链接; 填入你的主页链接即全站替换:
OWNER_GITHUB=
OWNER_TG=

# ---- 一键更新发布(管理后台版本弹窗按钮 → 触发 GitHub Actions) ----
# Cloudflare Pages 部署: 工作流自动注入(secrets.AUTOSYNC_TOKEN 缺省回落
#   Actions 内置 GITHUB_TOKEN), 此处留空即可。
# Node.js 部署: 填入 GitHub PAT(需 Actions: write 权限)。
#AUTOSYNC_TOKEN=
# 目标仓库(owner/repo): Pages 部署自动注入; Node 部署填你的 fork 仓库。
#GITHUB_REPOSITORY=
# 同步工作流文件与分支(一般无需修改)
#AUTOSYNC_WORKFLOW=sync-upstream.yml
#AUTOSYNC_BRANCH=main

# ---- 上游同步来源(一般无需修改; deploy.config.js upstreamRepo 亦可) ----
# 检测上游 _worker.js + 前端页面更新并自动同步发布; 留空用 deploy.config.js
#UPSTREAM_REPO=cmliu/edgetunnel
#UPSTREAM_BRANCH=main
