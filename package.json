{
  "name": "autotunnel",
  "version": "1.1.5",
  "private": false,
  "description": "Autotunnel — 多协议节点部署与订阅管理面板, 支持 Cloudflare Pages(KV/D1) 与 Node.js(node:sqlite) 双运行时自动适配, 优选订阅生成与用量统计",
  "license": "GPL-2.0",
  "homepage": "https://github.com/kentpan/autotunnel",
  "repository": {
    "type": "git",
    "url": "https://github.com/kentpan/autotunnel"
  },
  "scripts": {
    "prepare-core": "node scripts/prepare-core.mjs",
    "dev": "node scripts/prepare-core.mjs && next dev -p 3000 2>&1 | tee dev.log",
    "build": "node scripts/prepare-core.mjs && next build",
    "start": "node scripts/prepare-core.mjs && node server/node-server.mjs",
    "serve:node": "node scripts/prepare-core.mjs && node server/node-server.mjs",
    "lint": "eslint .",
    "pages:build": "node scripts/prepare-core.mjs && opennextjs-cloudflare build",
    "pages:adapter": "node scripts/build-pages-adapter.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/client": "^6.11.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "wrangler": "^4.141.0"
  }
}
