{
  "name": "autotunnel",
  "version": "1.0.5",
  "private": false,
  "description": "Autotunnel — 基于 Next.js 重构的 edgetunnel: 前端原样复刻, worker 服务端核心保持原版, 支持 Cloudflare Pages(KV/D1) 与 Node.js(node:sqlite) 自动适配; v1.0.5 统计面板 Token 权限预检+诊断指引+轮换自愈(Account Analytics:Read)",
  "license": "GPL-2.0",
  "homepage": "https://github.com/cmliu/edgetunnel",
  "repository": {
    "type": "git",
    "url": "https://github.com/kentpan/edgetunnel"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node server/node-server.mjs",
    "serve:node": "node server/node-server.mjs",
    "lint": "eslint .",
    "pages:build": "opennextjs-cloudflare build",
    "pages:adapter": "node scripts/build-pages-adapter.mjs",
    "pages:embed": "node scripts/embed-pages.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.11.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
